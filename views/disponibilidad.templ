package views

import (
	"fmt"

	"Los5/pkg/dominio"
)

templ DisponibilidadPage(d dominio.Disponibilidad) {
	@Layout("Disponibilidad", "departamentos") {
		<section class="panel">
			<div class="section-header">
				<div>
					<h2>Disponibilidad</h2>
					<p class="muted">{ d.Departamento.Nombre } · { d.Departamento.Direccion }</p>
				</div>
				<a href="/departamentos" class="btn btn-secondary">Volver a departamentos</a>
			</div>

			if d.Desde.IsZero() {
				<form action={ templ.URL(fmt.Sprintf("/departamentos/%d/disponibilidad", d.Departamento.IDDepto)) } method="get" class="filter-grid">
					<label>
						Desde
						<input type="date" name="desde" required/>
					</label>
					<label>
						Hasta
						<input type="date" name="hasta" required/>
					</label>
					<div class="form-actions">
						<button type="submit">Consultar</button>
					</div>
				</form>
			} else {
				<div class="summary-grid">
					<p><strong>Desde:</strong> { d.Desde.Format("2006-01-02") }</p>
					<p><strong>Hasta:</strong> { d.Hasta.Format("2006-01-02") }</p>
					<p><strong>Reservas solapadas:</strong> { fmt.Sprint(d.CantReservasSolapadas) }</p>
					if d.Disponible {
						<span class="badge badge-clean">Disponible</span>
					} else {
						<span class="badge badge-dirty">No disponible</span>
					}
				</div>
				<a href={ templ.URL(fmt.Sprintf("/departamentos/%d/disponibilidad", d.Departamento.IDDepto)) } class="btn btn-secondary">Consultar otro rango</a>
			}
		</section>
	}
}
