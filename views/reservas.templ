package views

import (
	"fmt"
	"Los5/pkg/dominio"
)

templ ReservasPage(reservas []dominio.ReservaConDetalle, deptos []dominio.Departamento, huespedes []dominio.Huesped, errMessage string) {
	@Layout("Reservas", "reservas") {
		<div style="background-color: var(--cream-50); padding: 1.5rem; border-radius: 1rem; border: 1px solid var(--cream-300);">
			<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
				<div>
					<h2 style="font-size: 1.25rem; font-weight: 700;">Gestión de Reservas</h2>
					<p style="font-size: 0.75rem; color: var(--slate-600);">Registro y control de ocupación.</p>
				</div>
				<button onclick="document.getElementById('modal-reserva').classList.remove('hidden')" class="btn btn-primary">
					+ Nueva Reserva
				</button>
			</div>

			<!-- Filtros HTTP GET -->
			<form action="/web/reservas" method="GET" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; background-color: var(--cream-100); padding: 1rem; border-radius: 0.75rem; margin-bottom: 1.5rem;">
				<div>
					<label style="font-size: 0.75rem; font-weight: 600; display: block; margin-bottom: 0.25rem;">Departamento</label>
					<select name="depto_id" class="form-control">
						<option value="">-- Todos --</option>
						for _, d := range deptos {
							<option value={ fmt.Sprint(d.IDDepto) }>{ d.Nombre }</option>
						}
					</select>
				</div>
				<div>
					<label style="font-size: 0.75rem; font-weight: 600; display: block; margin-bottom: 0.25rem;">Desde</label>
					<input type="date" name="desde" class="form-control"/>
				</div>
				<div>
					<label style="font-size: 0.75rem; font-weight: 600; display: block; margin-bottom: 0.25rem;">Hasta</label>
					<input type="date" name="hasta" class="form-control"/>
				</div>
				<div style="display: flex; align-self: flex-end;">
					<button type="submit" class="btn btn-primary" style="width: 100%;">Filtrar</button>
				</div>
			</form>

			<!-- Tabla de Reservas -->
			<div class="table-container">
				<table class="data-table">
					<thead>
						<tr>
							<th>ID</th>
							<th>Departamento</th>
							<th>Huésped</th>
							<th>Período</th>
							<th>Noches</th>
							<th>Precio Base</th>
						</tr>
					</thead>
					<tbody>
						if len(reservas) == 0 {
							<tr>
								<td colspan="6" style="text-align: center; color: var(--slate-400); font-style: italic;">No hay reservas registradas.</td>
							</tr>
						}
						for _, r := range reservas {
							<tr>
								<td style="font-family: monospace; font-weight: 700;">#{ fmt.Sprint(r.IDReserva) }</td>
								<td style="font-weight: 600;">{ r.NombreDepto }</td>
								<td>{ r.NombreHuesped } { r.ApellidoHuesped }</td>
								<td>{ r.FechaInicio.Format("2006-01-02") } &rarr; { r.FechaFin.Format("2006-01-02") }</td>
								<td>{ fmt.Sprint(r.CantNoches) } noc.</td>
								<td style="font-weight: 600; color: var(--success-text);">${ fmt.Sprintf("%.2f", r.PrecioBase) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>

		@ReservaFormModal(deptos, huespedes, errMessage)
	}
}

templ ReservaFormModal(deptos []dominio.Departamento, huespedes []dominio.Huesped, errMessage string) {
	<div id="modal-reserva" class={ "modal-backdrop", templ.KV("hidden", errMessage == "") }>
		<div class="modal-box">
			<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
				<h3 style="font-weight: 700;">Nueva Reserva</h3>
				<button onclick="document.getElementById('modal-reserva').classList.add('hidden')" style="background: none; border: none; cursor: pointer;">✕</button>
			</div>

			if errMessage != "" {
				<div style="background-color: var(--danger-bg); color: var(--danger-text); border: 1px solid var(--danger-border); padding: 0.75rem; border-radius: 0.5rem; font-size: 0.8rem; margin-bottom: 1rem;">
					⚠️ { errMessage }
				</div>
			}

			<form action="/web/reservas" method="POST">
				<div class="form-group">
					<label>Departamento *</label>
					<select name="id_depto" required class="form-control">
						for _, d := range deptos {
							<option value={ fmt.Sprint(d.IDDepto) }>{ d.Nombre }</option>
						}
					</select>
				</div>
				<div class="form-group">
					<label>Huésped Principal *</label>
					<select name="id_huesped" required class="form-control">
						for _, h := range huespedes {
							<option value={ fmt.Sprint(h.IDHuesped) }>{ h.Nombre } { h.Apellido }</option>
						}
					</select>
				</div>
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
					<div class="form-group">
						<label>Fecha Inicio *</label>
						<input type="date" name="fecha_inicio" required class="form-control"/>
					</div>
					<div class="form-group">
						<label>Fecha Fin *</label>
						<input type="date" name="fecha_fin" required class="form-control"/>
					</div>
				</div>
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
					<div class="form-group">
						<label>Cant. Noches *</label>
						<input type="number" name="cant_noches" min="1" required class="form-control"/>
					</div>
					<div class="form-group">
						<label>Precio Base ($) *</label>
						<input type="number" step="0.01" name="precio_base" required class="form-control"/>
					</div>
				</div>
				<div style="display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 1rem;">
					<button type="button" onclick="document.getElementById('modal-reserva').classList.add('hidden')" class="btn btn-secondary">Cancelar</button>
					<button type="submit" class="btn btn-primary">Guardar Reserva</button>
				</div>
			</form>
		</div>
	</div>
}