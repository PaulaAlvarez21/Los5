package views

import "fmt"

templ ReservasPage(data ReservasPageData) {
	@Layout("Reservas", "reservas") {
		@ErrorBanner(data.Error)
		<details class="panel" open>
			<summary><strong>+ Nueva reserva</strong></summary>
			<div class="details-body">
				@ReservaForm(data.Departamentos, data.Huespedes)
			</div>
		</details>
		<section class="panel">
			<div class="section-header">
				<div>
					<h2>Gestión de reservas</h2>
					<p class="muted">Registro y control de ocupación.</p>
				</div>
			</div>
			<form action="/reservas" method="get" class="filter-grid">
				<label>
					Departamento
					<select name="depto_id">
						<option value="">-- Todos --</option>
						for _, d := range data.Departamentos {
							if data.Filtro.DeptoID == fmt.Sprint(d.IDDepto) {
								<option value={ fmt.Sprint(d.IDDepto) } selected>{ d.Nombre }</option>
							} else {
								<option value={ fmt.Sprint(d.IDDepto) }>{ d.Nombre }</option>
							}
						}
					</select>
				</label>
				<label>
					Desde
					<input type="date" name="desde" value={ data.Filtro.Desde }/>
				</label>
				<label>
					Hasta
					<input type="date" name="hasta" value={ data.Filtro.Hasta }/>
				</label>
				<div class="form-actions">
					<button type="submit">Filtrar</button>
				</div>
			</form>
			@ReservaList(data.Reservas)
		</section>
	}
}
