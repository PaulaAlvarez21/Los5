package views

import (
	"fmt"

	"Los5/pkg/dominio"
)

templ TotalReservaPage(total dominio.TotalReserva) {
	@Layout("Total de reserva", "reservas") {
		<section class="panel">
			<div class="section-header">
				<div>
					<h2>Total de reserva</h2>
					<p class="muted">Reserva #{ fmt.Sprint(total.Reserva.IDReserva) }</p>
				</div>
				<a href="/reservas" class="btn btn-secondary">Volver a reservas</a>
			</div>

			<div class="table-container">
				<table class="data-table">
					<tbody>
						<tr>
							<th>Período</th>
							<td>{ total.Reserva.FechaInicio.Format("2006-01-02") } → { total.Reserva.FechaFin.Format("2006-01-02") }</td>
						</tr>
						<tr>
							<th>Noches</th>
							<td>{ fmt.Sprint(total.Reserva.CantNoches) }</td>
						</tr>
						<tr>
							<th>Subtotal</th>
							<td>${ total.Subtotal }</td>
						</tr>
						<tr>
							<th>Descuento</th>
							<td>{ total.DescuentoPorcentaje }%</td>
						</tr>
						<tr>
							<th>Total</th>
							<td class="strong success-text">${ total.Total }</td>
						</tr>
					</tbody>
				</table>
			</div>
		</section>
	}
}
