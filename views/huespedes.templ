package views

templ HuespedesPage(data HuespedesPageData) {
	@Layout("Huéspedes", "huespedes") {
		@ErrorBanner(data.Error)
		<details class="panel" open>
			<summary><strong>+ Nuevo huésped</strong></summary>
			<div class="details-body">
				@HuespedForm(data.Reservas)
			</div>
		</details>
		<section class="panel">
			<div class="section-header">
				<div>
					<h2>Padrón de huéspedes</h2>
					<p class="muted">Registro general de clientes.</p>
				</div>
			</div>
			@HuespedList(data.Huespedes)
		</section>
	}
}
