package views

import (
	"Los5/pkg/dominio"
)

templ HuespedesPage(huespedes []dominio.Huesped) {
	@Layout("Huéspedes", "huespedes") {
		<div style="background-color: var(--cream-50); padding: 1.5rem; border-radius: 1rem; border: 1px solid var(--cream-300);">
			<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
				<div>
					<h2 style="font-size: 1.25rem; font-weight: 700;">Padrón de Huéspedes</h2>
					<p style="font-size: 0.75rem; color: var(--slate-600);">Registro general de clientes.</p>
				</div>
				<button onclick="document.getElementById('modal-huesped').classList.remove('hidden')" class="btn btn-primary">
					+ Nuevo Huésped
				</button>
			</div>

			<div class="table-container">
				<table class="data-table">
					<thead>
						<tr>
							<th>Nombre y Apellido</th>
							<th>Teléfono</th>
							<th>Email</th>
							<th>Observaciones</th>
						</tr>
					</thead>
					<tbody>
						if len(huespedes) == 0 {
							<tr>
								<td colspan="4" style="text-align: center; color: var(--slate-400); font-style: italic;">No hay huéspedes registrados.</td>
							</tr>
						}
						for _, h := range huespedes {
							<tr>
								<td style="font-weight: 700;">{ h.Nombre } { h.Apellido }</td>
								<td>{ valorTexto(h.Telefono) }</td>
								<td>{ valorTexto(h.Email) }</td>
								<td style="font-size: 0.75rem; color: var(--slate-600);">{ valorTexto(h.Observaciones) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>

		@HuespedFormModal()
	}
}

templ HuespedFormModal() {
	<div id="modal-huesped" class="modal-backdrop hidden">
		<div class="modal-box">
			<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
				<h3 style="font-weight: 700;">Nuevo Huésped</h3>
				<button onclick="document.getElementById('modal-huesped').classList.add('hidden')" style="background: none; border: none; cursor: pointer;">✕</button>
			</div>
			<form action="/web/huespedes" method="POST">
				<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
					<div class="form-group">
						<label>Nombre *</label>
						<input type="text" name="nombre" required class="form-control"/>
					</div>
					<div class="form-group">
						<label>Apellido *</label>
						<input type="text" name="apellido" required class="form-control"/>
					</div>
				</div>
				<div class="form-group">
					<label>Teléfono</label>
					<input type="text" name="telefono" class="form-control"/>
				</div>
				<div class="form-group">
					<label>Email</label>
					<input type="email" name="email" class="form-control"/>
				</div>
				<div class="form-group">
					<label>Observaciones</label>
					<textarea name="observaciones" rows="2" class="form-control"></textarea>
				</div>
				<div style="display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 1rem;">
					<button type="button" onclick="document.getElementById('modal-huesped').classList.add('hidden')" class="btn btn-secondary">Cancelar</button>
					<button type="submit" class="btn btn-primary">Guardar Huésped</button>
				</div>
			</form>
		</div>
	</div>
}