package views

import (
	"fmt"
	"Los5/pkg/dominio"
)

templ DepartamentosPage(deptos []dominio.Departamento) {
	@Layout("Departamentos", "departamentos") {
		<div class="page-header">
			<div>
				<h2 style="font-size: 1.25rem; font-weight: 700;">Catálogo de Departamentos</h2>
				<p style="font-size: 0.75rem; color: var(--slate-600);">Administración de oferta inmobiliaria e higiene.</p>
			</div>
			<button onclick="document.getElementById('modal-depto').classList.remove('hidden')" class="btn btn-primary">
				+ Nuevo Departamento
			</button>
		</div>

		<div class="grid-cards">
			for _, d := range deptos {
				@DeptoCard(d)
			}
		</div>

		@DeptoFormModal()
	}
}

templ DeptoCard(d dominio.Departamento) {
	<div class="depto-card">
		<div>
			<div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.5rem;">
				<h3 style="font-family: 'Cormorant Garamond', serif; font-size: 1.25rem; font-weight: 700;">{ d.Nombre }</h3>
				if d.Limpio {
					<span class="badge badge-clean">🧹 Limpio</span>
				} else {
					<span class="badge badge-dirty">⚠️ Mantenimiento</span>
				}
			</div>
			<p style="font-size: 0.75rem; color: var(--slate-600); margin-bottom: 0.5rem;">📍 { d.Direccion }</p>
			<p style="font-size: 0.825rem; color: var(--slate-800);">{ d.Descripcion }</p>
		</div>
		<div style="display: flex; gap: 0.5rem; margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid var(--cream-200);">
			<form action={ templ.URL(fmt.Sprintf("/departamentos/%d/limpieza", d.IDDepto)) } method="POST" style="flex: 1;">
				<button type="submit" class="btn btn-secondary" style="width: 100%;">Cambiar Higiene</button>
			</form>
			<a href={ templ.URL(fmt.Sprintf("/reservas?depto_id=%d", d.IDDepto)) } class="btn btn-primary" style="flex: 1; text-align: center;">Ver Reservas</a>
		</div>
	</div>
}

templ DeptoFormModal() {
	<div id="modal-depto" class="modal-backdrop hidden">
		<div class="modal-box">
			<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
				<h3 style="font-weight: 700;">Nuevo Departamento</h3>
				<button onclick="document.getElementById('modal-depto').classList.add('hidden')" style="background: none; border: none; cursor: pointer;">✕</button>
			</div>
			<form action="/departamentos" method="POST">
				<div class="form-group">
					<label>Nombre *</label>
					<input type="text" name="nombre" required class="form-control"/>
				</div>
				<div class="form-group">
					<label>Dirección *</label>
					<input type="text" name="direccion" required class="form-control"/>
				</div>
				<div class="form-group">
					<label>Descripción</label>
					<textarea name="descripcion" rows="3" class="form-control"></textarea>
				</div>
				<div class="form-group">
					<label>Estado de Higiene</label>
					<select name="limpio" class="form-control">
						<option value="true">🧹 Limpio</option>
						<option value="false">⚠️ Mantenimiento</option>
					</select>
				</div>
				<div style="display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 1.5rem;">
					<button type="button" onclick="document.getElementById('modal-depto').classList.add('hidden')" class="btn btn-secondary">Cancelar</button>
					<button type="submit" class="btn btn-primary">Guardar</button>
				</div>
			</form>
		</div>
	</div>
}