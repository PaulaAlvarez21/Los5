package views

templ InicioPage() {
	@Layout("Inicio", "") {
		<div class="page-header">
			<div>
				<h2 style="font-size: 1.25rem; font-weight: 700;">Gestión de Los 5 Alquileres</h2>
				<p style="font-size: 0.875rem; color: var(--slate-600);">Seleccione una sección para comenzar.</p>
			</div>
		</div>
		<div class="grid-cards">
			<a href="/web/reservas" class="depto-card" style="text-decoration: none; color: inherit;">
				<h3 style="font-size: 1.25rem; font-weight: 700;">Reservas</h3>
				<p style="color: var(--slate-600);">Consultar y registrar reservas.</p>
			</a>
			<a href="/web/huespedes" class="depto-card" style="text-decoration: none; color: inherit;">
				<h3 style="font-size: 1.25rem; font-weight: 700;">Huéspedes</h3>
				<p style="color: var(--slate-600);">Consultar y registrar huéspedes.</p>
			</a>
			<a href="/web/departamentos" class="depto-card" style="text-decoration: none; color: inherit;">
				<h3 style="font-size: 1.25rem; font-weight: 700;">Departamentos</h3>
				<p style="color: var(--slate-600);">Consultar y registrar departamentos.</p>
			</a>
		</div>
	}
}
