package views

templ HuespedesPorDepartamentoPage(data HuespedesPorDepartamentoPageData) {
	@Layout("Huéspedes por departamento", "departamentos") {
		@ErrorBanner(data.Error)
		<section class="panel">
			<div class="section-header">
				<div>
					<h2>Huéspedes de { data.Departamento.Nombre }</h2>
					<p class="muted">{ data.Departamento.Direccion }</p>
				</div>
				<a href="/departamentos" class="btn btn-secondary">Volver a departamentos</a>
			</div>
			@HuespedList(data.Huespedes)
		</section>
	}
}
