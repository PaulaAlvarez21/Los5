package views

templ Layout(title string, activeTab string) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } - Los 5 Alquileres</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/styles.css"/>
		</head>
		<body>
			@Header(activeTab)
			<main class="main-content">
				{ children... }
			</main>
		</body>
	</html>
}

templ Header(activeTab string) {
	<header class="header-bar">
		<div class="header-container">
			<a href="/" class="brand-logo">
				<div>
					<h1 class="brand-title">Los 5 Alquileres</h1>
				</div>
			</a>
			<nav class="nav-pills">
				<a href="/web/reservas" class={ "nav-link", templ.KV("active", activeTab == "reservas") }>Reservas</a>
				<a href="/web/departamentos" class={ "nav-link", templ.KV("active", activeTab == "departamentos") }>Departamentos</a>
				<a href="/web/huespedes" class={ "nav-link", templ.KV("active", activeTab == "huespedes") }>Huéspedes</a>
			</nav>
		</div>
	</header>
}
