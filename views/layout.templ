package views

templ Layout(title string, activeTab string) {
	<!DOCTYPE html>
	<html lang="es" data-theme="light">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } - Los 5 Alquileres</title>
			<link rel="stylesheet" href="/static/pico.min.css"/>
			<link rel="stylesheet" href="/static/styles.css"/>
		</head>
		<body>
			@Header(activeTab)
			<main class="container main-content">
				{ children... }
			</main>
		</body>
	</html>
}

templ Header(activeTab string) {
	<header class="header-bar">
		<div class="header-container">
			<a href="/" class="brand-logo">
				<h1 class="brand-title">Los 5 Alquileres</h1>
			</a>
			<nav class="nav-pills">
				<a href="/" class={ "nav-link", templ.KV("active", activeTab == "inicio") }>Inicio</a>
				<a href="/departamentos" class={ "nav-link", templ.KV("active", activeTab == "departamentos") }>Departamentos</a>
				<a href="/reservas" class={ "nav-link", templ.KV("active", activeTab == "reservas") }>Reservas</a>
				<a href="/huespedes" class={ "nav-link", templ.KV("active", activeTab == "huespedes") }>Huéspedes</a>
			</nav>
		</div>
	</header>
}

templ ErrorBanner(mensaje string) {
	if mensaje != "" {
		<div class="alert alert-error" role="alert">{ mensaje }</div>
	}
}
